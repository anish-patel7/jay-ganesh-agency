# ---- Required to go live ----
SERVER_ENABLED=true
NODE_ENV=production
TRUST_PROXY=true
PORT=3000

# Google Sheet ID: the long code in the sheet URL between /d/ and /edit
GOOGLE_SHEETS_ID=put-google-sheet-id-here
# Paste the WHOLE service-account JSON key here (one line is fine)...
GOOGLE_SERVICE_ACCOUNT_JSON=
# ...or, for running on your own computer, point to the key file instead:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/private/path/service-account.json

# Random text, at least 32 characters (Render generates this for you)
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Main Admin login
ADMIN_MOBILE=9999999999
ADMIN_PASSWORD=choose-a-password-of-10-or-more-characters
# (Advanced alternative to ADMIN_PASSWORD: ADMIN_PASSWORD_SALT / ADMIN_PASSWORD_HASH
#  from `node server/password-helper.js`)

# ---- Optional ----
# Private Google Drive folder for order PDF uploads (not needed for now)
GOOGLE_DRIVE_FOLDER_ID=

# Keep false until registrations / payments should open to customers
OPERATIONS_ENABLED=false
POLICY_APPROVED=false
FIREWORKS_LEGAL_CLEARANCE=false
