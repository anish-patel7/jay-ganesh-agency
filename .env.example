# SERVER CONFIGURATION — ALL OPERATIONS OFF BY DEFAULT
PORT=3000
SERVER_ENABLED=false
NODE_ENV=development
TRUST_PROXY=false

# Keep true-only after formal approvals and testing.
OPERATIONS_ENABLED=false
POLICY_APPROVED=false
FIREWORKS_LEGAL_CLEARANCE=false

# Required when SERVER_ENABLED=true.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/private/path/service-account.json
GOOGLE_SHEETS_ID=put-google-sheet-id-here
GOOGLE_DRIVE_FOLDER_ID=put-private-folder-id-here
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_MOBILE=9999999999
ADMIN_PASSWORD_SALT=fill-from-password-helper
ADMIN_PASSWORD_HASH=fill-from-password-helper
